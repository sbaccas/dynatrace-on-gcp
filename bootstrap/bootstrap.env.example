# ==============================================================================
# Dynatrace Observability Platform - Bootstrap Configuration Template
# ==============================================================================
# Copy this file to bootstrap/bootstrap.env and populate with your environment
# values before running ./scripts/00_bootstrap.sh.
# NOTE: bootstrap/bootstrap.env is gitignored to protect secrets & project IDs.
# ==============================================================================

# GCP Organization & Folders
GCP_ORG_ID="123456789012"
GCP_ORG_DOMAIN="enterprise-org.example.com"
OBSERVABILITY_FOLDER_NAME="Observability"
OBSERVABILITY_FOLDER_ID="111111111111"
BILLING_ACCOUNT_ID="000000-000000-000000"

# Control / DevOps Plane
GCP_CONTROL_PROJECT_ID="dynatrace-control-prod"
TF_STATE_BUCKET="dynatrace-control-tfstate-123456789012"
TF_STATE_PREFIX="terraform/state/observability-platform"

# Observability Infrastructure Plane
GCP_PLATFORM_PROJECT_ID="dynatrace-platform-prod"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"

# GKE Cluster Settings
GKE_CLUSTER_NAME="dynatrace-forwarder-gke"
GKE_MACHINE_TYPE="e2-standard-2"
GKE_NODE_COUNT="2"

# Artifact Registry Settings
GAR_REPOSITORY_ID="dynatrace-repo"

# Pub/Sub Logging Settings
PUBSUB_TOPIC_NAME="dynatrace-gcp-logs"
PUBSUB_SUBSCRIPTION_NAME="dynatrace-gcp-logs-sub"

# Scoping Projects (Metrics)
SCOPING_PROJECTS_FOLDER_NAME="Scoping Projects"
SCOPING_PROJECTS_FOLDER_ID="222222222222"
GCP_SCOPING_PROJECT_ID="dynatrace-scope-01-prod"
MONITORED_PROJECT_IDS='["dynatrace-platform-prod", "workload-app-prod"]'

# Phase 2: Dynatrace Tenant & ActiveGate Settings
DYNATRACE_URL="https://<your-environment-id>.live.dynatrace.com"
DYNATRACE_API_TOKEN="dt0c01.<your-token-public-id>.<your-token-secret>"
WORKLOAD_PROJECT_ID="workload-app-prod"
ACTIVEGATE_NETWORK_ZONE="workload-prod"
ACTIVEGATE_VPC_NAME="workload-vpc"
ACTIVEGATE_ZONES='["us-central1-a", "us-central1-b"]'
ACTIVEGATE_SUBNET_NAME="workload-activegate-subnet"
ACTIVEGATE_SUBNET_CIDR="10.10.2.0/24"
ACTIVEGATE_SOURCE_CIDRS='["10.10.0.0/24", "10.10.2.0/24"]'
TARGET_WORKLOAD_VM="workload-vm-01"
TARGET_WORKLOAD_ZONE="us-central1-a"
